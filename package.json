{
  "name": "bravhas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma generate && tsx prisma/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "seed": "npm run db:seed",
    "auth:set-password": "prisma generate && tsx scripts/set-user-password.ts",
    "e2e:seed": "prisma generate && tsx scripts/e2e-seed.ts && tsx scripts/e2e-homo-005-fixtures.ts && tsx scripts/e2e-readiness-fixtures.ts",
    "recovery:fixture": "tsx scripts/recovery-fixture.ts",
    "recovery:verify": "tsx scripts/recovery-verify.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:contracts": "node scripts/production-preflight.mjs --self-test && node scripts/restore-database.mjs --self-test && node scripts/backup-database.mjs",
    "test:integrity": "tsx scripts/data-integrity-check.ts",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test tests/e2e/auth.spec.ts --project=chromium",
    "test:e2e:security": "playwright test tests/e2e/security.spec.ts tests/e2e/readiness-security.spec.ts tests/e2e/financial-cash-flow.spec.ts tests/e2e/homo-005-rbac.spec.ts --project=chromium",
    "test:e2e:functional": "playwright test tests/e2e/functional-golden-path.spec.ts tests/e2e/document-metadata.spec.ts tests/e2e/homo-005-human-path.spec.ts --project=chromium",
    "test:e2e:desktop": "playwright test tests/e2e/product-desktop.spec.ts --project=chromium",
    "test:e2e:mobile": "playwright test tests/e2e/mobile.spec.ts --project=mobile-chromium",
    "prod:preflight": "node scripts/production-preflight.mjs",
    "backup:dry-run": "node scripts/backup-database.mjs",
    "backup:execute": "node scripts/backup-database.mjs --execute",
    "restore:guard:self-test": "node scripts/restore-database.mjs --self-test",
    "restore:dry-run": "node scripts/restore-database.mjs",
    "restore:execute": "node scripts/restore-database.mjs --execute --confirm-non-production",
    "deploy:smoke": "node scripts/post-deploy-smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@vercel/blob": "2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "fast-uri": "3.1.7",
    "js-yaml": "4.3.2",
    "mysql2": "3.23.1",
    "qs": "6.16.0",
    "sharp": "0.35.4"
  }
}
