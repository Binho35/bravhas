generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  FINANCIAL
  HR
  PAYROLL
  OPERATIONAL
}

enum FinancialAccountType {
  PAYABLE
  RECEIVABLE
}

enum FinancialAccountStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELED
}

enum FinancialTransactionType {
  PAYMENT
  RECEIPT
  REVERSAL
  CANCELLATION
}

model Company {
  id        String   @id @default(uuid())
  name      String
  prefix    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
  users    User[]

  suppliers    Supplier[]
  customers    Customer[]
  categories   FinancialCategory[]
  costCenters  CostCenter[]
  bankAccounts BankAccount[]

  financialAccounts FinancialAccount[]

  @@unique([prefix])
  @@index([active])
}

model Branch {
  id        String   @id @default(uuid())
  companyId String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  users User[]

  suppliers    Supplier[]
  customers    Customer[]
  categories   FinancialCategory[]
  costCenters  CostCenter[]
  bankAccounts BankAccount[]

  financialAccounts FinancialAccount[]

  @@index([companyId])
  @@index([active])
}

model User {
  id            String   @id @default(uuid())
  companyId     String
  branchId      String?
  companyPrefix String
  username      String
  loginId       String   @unique
  name          String
  email         String
  role          UserRole
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  sessions UserSession[]

  createdFinancialAccounts FinancialAccount[] @relation("FinancialAccountCreatedBy")
  updatedFinancialAccounts FinancialAccount[] @relation("FinancialAccountUpdatedBy")

  financialTransactions FinancialTransaction[]

  @@index([companyId])
  @@index([branchId])
  @@index([email])
  @@index([role])
  @@index([active])
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Supplier {
  id        String   @id @default(uuid())
  companyId String
  branchId  String?

  name      String
  document  String?
  email     String?
  phone     String?
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  financialAccounts FinancialAccount[]

  @@index([companyId])
  @@index([branchId])
  @@index([document])
  @@index([active])
}

model Customer {
  id        String   @id @default(uuid())
  companyId String
  branchId  String?

  name      String
  document  String?
  email     String?
  phone     String?
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  financialAccounts FinancialAccount[]

  @@index([companyId])
  @@index([branchId])
  @@index([document])
  @@index([active])
}

model FinancialCategory {
  id        String   @id @default(uuid())
  companyId String
  branchId  String?

  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  financialAccounts FinancialAccount[]

  @@index([companyId])
  @@index([branchId])
  @@index([active])
}

model CostCenter {
  id        String   @id @default(uuid())
  companyId String
  branchId  String?

  name        String
  code        String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  financialAccounts FinancialAccount[]

  @@index([companyId])
  @@index([branchId])
  @@index([active])
}

model BankAccount {
  id        String   @id @default(uuid())
  companyId String
  branchId  String?

  name          String
  bankCode      String?
  bankName      String?
  agency        String?
  accountNumber String?
  accountType   String?
  pixKey        String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  financialAccounts FinancialAccount[]

  @@index([companyId])
  @@index([branchId])
  @@index([active])
}

model FinancialAccount {
  id        String @id @default(uuid())
  companyId String
  branchId  String

  costCenterId  String?
  categoryId    String?
  supplierId    String?
  customerId    String?
  bankAccountId String?

  type   FinancialAccountType
  status FinancialAccountStatus

  description    String
  documentNumber String?

  issueDate   DateTime
  dueDate     DateTime
  paymentDate DateTime?

  amount     Decimal @db.Decimal(15, 2)
  paidAmount Decimal @db.Decimal(15, 2)

  discount Decimal @db.Decimal(15, 2)
  interest Decimal @db.Decimal(15, 2)
  fine     Decimal @db.Decimal(15, 2)

  notes String?

  createdBy String
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  costCenter CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  category FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdByUser User @relation("FinancialAccountCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  updatedByUser User? @relation("FinancialAccountUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  transactions FinancialTransaction[]

  @@index([companyId])
  @@index([branchId])
  @@index([costCenterId])
  @@index([categoryId])
  @@index([supplierId])
  @@index([customerId])
  @@index([bankAccountId])
  @@index([type])
  @@index([status])
  @@index([dueDate])
  @@index([paymentDate])
  @@index([createdBy])
  @@index([updatedBy])
}

model FinancialTransaction {
  id String @id @default(uuid())

  accountId   String
  performedBy String

  type FinancialTransactionType

  amount Decimal @db.Decimal(15, 2)

  performedAt DateTime

  notes String?

  createdAt DateTime @default(now())

  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  user User @relation(fields: [performedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([accountId])
  @@index([performedBy])
  @@index([type])
  @@index([performedAt])
}

enum EmployeeStatus {
  PRE_ADMISSION
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum EmploymentType {
  CLT
  EXPERIENCE
  INTERN
  APPRENTICE
  CONTRACTOR
  TEMPORARY
  OTHER
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum HrRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELED
  COMPLETED
}

enum HrTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_EMPLOYEE
  RESOLVED
  CLOSED
}

enum DisciplinaryActionType {
  VERBAL_GUIDANCE
  WRITTEN_WARNING
  SUSPENSION
  TERMINATION_FOR_CAUSE
}

model HrDepartment {
  id          String   @id @default(uuid())
  companyId   String
  branchId    String?
  name        String
  code        String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  positions HrPosition[]
  employees HrEmployee[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([branchId])
  @@index([active])
}

model HrPosition {
  id           String   @id @default(uuid())
  companyId    String
  departmentId String?
  name         String
  cbo          String?
  description  String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department HrDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  employees  HrEmployee[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([departmentId])
  @@index([active])
}

model HrEmployee {
  id              String         @id @default(uuid())
  companyId       String
  branchId        String?
  departmentId    String?
  positionId      String?
  managerId       String?
  employeeNumber  String?
  fullName        String
  socialName      String?
  cpf             String?
  rg              String?
  birthDate       DateTime?
  emailPersonal   String?
  emailCorporate  String?
  phone           String?
  hireDate        DateTime?
  terminationDate DateTime?
  employmentType  EmploymentType?
  workMode        WorkMode?
  weeklyHours     Decimal?       @db.Decimal(6, 2)
  baseSalary      Decimal?       @db.Decimal(15, 2)
  status          EmployeeStatus @default(PRE_ADMISSION)
  active          Boolean        @default(true)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  department HrDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  position   HrPosition?   @relation(fields: [positionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  manager    HrEmployee?   @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reports    HrEmployee[]  @relation("EmployeeManager")

  documents          HrEmployeeDocument[]
  timeOccurrences    HrTimeOccurrence[]
  vacationRequests   HrVacationRequest[]
  leaveRequests      HrLeaveRequest[]
  benefitEnrollments HrBenefitEnrollment[]
  disciplinaryActions HrDisciplinaryAction[]
  tickets            HrTicket[]

  @@unique([companyId, employeeNumber])
  @@unique([companyId, cpf])
  @@index([companyId])
  @@index([branchId])
  @@index([departmentId])
  @@index([positionId])
  @@index([managerId])
  @@index([status])
  @@index([active])
  @@index([fullName])
}

model HrEmployeeDocument {
  id         String   @id @default(uuid())
  companyId  String
  employeeId String
  type       String
  title      String
  storageKey String?
  issuedAt   DateTime?
  expiresAt  DateTime?
  verifiedAt DateTime?
  verifiedBy String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@index([type])
  @@index([expiresAt])
}

model HrTimeOccurrence {
  id          String          @id @default(uuid())
  companyId   String
  employeeId  String
  referenceDate DateTime
  type        String
  description String
  status      HrRequestStatus @default(PENDING)
  employeeNote String?
  managerNote  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@index([referenceDate])
  @@index([status])
}

model HrVacationRequest {
  id          String          @id @default(uuid())
  companyId   String
  employeeId  String
  startDate   DateTime
  endDate     DateTime
  sellDays    Int             @default(0)
  advance13th Boolean         @default(false)
  status      HrRequestStatus @default(PENDING)
  requestedAt DateTime        @default(now())
  approvedAt  DateTime?
  approvedBy  String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@index([startDate])
  @@index([status])
}

model HrLeaveRequest {
  id          String          @id @default(uuid())
  companyId   String
  employeeId  String
  type        String
  startDate   DateTime
  endDate     DateTime?
  cid         String?
  benefitNumber String?
  status      HrRequestStatus @default(PENDING)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@index([startDate])
  @@index([status])
}

model HrBenefitEnrollment {
  id          String   @id @default(uuid())
  companyId   String
  employeeId  String
  benefitType String
  provider    String?
  monthlyValue Decimal? @db.Decimal(15, 2)
  employeeDiscount Decimal? @db.Decimal(15, 2)
  active      Boolean  @default(true)
  startedAt   DateTime?
  endedAt     DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@index([benefitType])
  @@index([active])
}

model HrDisciplinaryAction {
  id          String                 @id @default(uuid())
  companyId   String
  employeeId  String
  type        DisciplinaryActionType
  occurredAt  DateTime
  reason      String
  description String?
  issuedBy    String?
  acknowledgedAt DateTime?
  documentKey String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@index([type])
  @@index([occurredAt])
}

model HrTicket {
  id          String         @id @default(uuid())
  companyId   String
  employeeId  String?
  protocol    String         @unique
  category    String
  subject     String
  description String
  status      HrTicketStatus @default(OPEN)
  priority    String         @default("NORMAL")
  assignedTo  String?
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  employee HrEmployee? @relation(fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}
