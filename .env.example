# Banco principal da aplicação
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Prisma migrations / acesso direto
DATABASE_DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_SHADOW"

# Ambiente da aplicação
# Valores usados pelo repositório: TEST, HOMOLOGATION e PRODUCTION.
BRAVHAS_ENV="TEST"
NODE_ENV="development"

# Bypass de autenticação: desenvolvimento controlado apenas.
# Deve permanecer false em homologação e produção.
BRAVHAS_DEV_AUTH_BYPASS="false"

# Storage documental.
# Em desenvolvimento/homologação pode ser "local".
# Em produção, "local" é bloqueado e um adapter persistente homologado será obrigatório.
BRAVHAS_DOCUMENT_STORAGE_PROVIDER="local"

# Backup: diretório local opcional para tooling operacional.
# O script usa .bravhas/backups quando omitido.
BRAVHAS_BACKUP_DIR=".bravhas/backups"

# Restore: guarda adicional para execução NÃO produtiva.
# Manter false por padrão. Produção é bloqueada mesmo quando true.
BRAVHAS_RESTORE_ALLOWED="false"

# Smoke pós-deploy. Definir apenas no ambiente de execução do smoke.
BRAVHAS_BASE_URL="https://example.invalid"
BRAVHAS_SMOKE_LOGIN_ID="SMOKE_LOGIN_ID"
BRAVHAS_SMOKE_PASSWORD="SMOKE_PASSWORD"

# Opcional: ID de documento pertencente a outro tenant de homologação,
# usado exclusivamente para validar que o tenant autenticado recebe 404.
BRAVHAS_SMOKE_FOREIGN_DOCUMENT_ID=""
