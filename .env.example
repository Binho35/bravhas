# Banco principal da aplicação
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Prisma migrations / acesso direto
DATABASE_DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_SHADOW"

# Ambiente da aplicação
# Valores usados pelo repositório: TEST, HOMOLOGATION e produção via NODE_ENV=production.
BRAVHAS_ENV="TEST"
NODE_ENV="development"

# Bypass de autenticação deve permanecer false fora de desenvolvimento controlado.
# O Quality bloqueia ativação insegura no código e os E2E sempre executam com false.
BRAVHAS_DEV_AUTH_BYPASS="false"
